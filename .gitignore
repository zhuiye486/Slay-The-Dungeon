# Slay-The-Dungeon 项目专属 .gitignore
# 适用 Java + Maven 技术栈

# --------------------------
# IDE & 编辑器配置
# --------------------------
# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
# VS Code
.vscode/
*.swp
*.swo
# Eclipse
.classpath
.project
.settings/

# --------------------------
# Maven 构建输出
# --------------------------
target/
*.jar
*.war
*.ear
# 可选：若不需要在仓库中保留 Maven Wrapper 的 jar 包，可取消注释
# .mvn/wrapper/maven-wrapper.jar

# --------------------------
# 操作系统自动生成文件
# --------------------------
# macOS
.DS_Store
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
# Linux
*~

# --------------------------
# 日志、缓存与临时文件
# --------------------------
*.log
*.tmp
.cache/
logs/
temp/

# --------------------------
# 本地配置（含敏感信息）
# --------------------------
# 开发环境配置（避免提交密码、密钥等）
application-dev.yml
application-local.properties
*.env
# 个人调试配置
debug.log

# --------------------------
# 测试与覆盖率报告
# --------------------------
surefire-reports/
jacoco/
coverage/